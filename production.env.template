# Production Environment Configuration Template
# Copy this file to .env and customize for your environment

#=============================================================================
# DATABASE CONFIGURATION
#=============================================================================
POSTGRES_DB=odoo_production
POSTGRES_USER=odoo_prod
# CRITICAL: Change this to a strong password
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

#=============================================================================
# ODOO CONFIGURATION
#=============================================================================
# CRITICAL: Change this to a strong admin password
ODOO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_HERE

# Performance settings (adjust based on your server resources)
ODOO_WORKERS=4
ODOO_MAX_CRON_THREADS=2
ODOO_LOG_LEVEL=warn

# Memory limits (in bytes)
ODOO_LIMIT_MEMORY_HARD=2684354560    # 2.5GB
ODOO_LIMIT_MEMORY_SOFT=2147483648    # 2GB
ODOO_LIMIT_TIME_CPU=600              # 10 minutes
ODOO_LIMIT_TIME_REAL=1200            # 20 minutes
ODOO_LIMIT_REQUEST=8192              # Max requests per worker

#=============================================================================
# NGINX CONFIGURATION
#=============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

#=============================================================================
# STORAGE PATHS
#=============================================================================
# Paths for persistent data storage
DATA_PATH=/opt/odoo-production/data
BACKUP_PATH=/opt/odoo-production/backups

#=============================================================================
# SSL/TLS CONFIGURATION
#=============================================================================
# SSL certificate paths (if using HTTPS)
SSL_CERT_PATH=/etc/ssl/certs/odoo.crt
SSL_KEY_PATH=/etc/ssl/private/odoo.key

#=============================================================================
# DOMAIN CONFIGURATION
#=============================================================================
# Your production domain
DOMAIN=your-domain.com
EMAIL=admin@your-domain.com

#=============================================================================
# SECURITY SETTINGS
#=============================================================================
# Database list visibility (keep false for production)
LIST_DB=false

# Proxy mode (set to true if behind reverse proxy)
PROXY_MODE=true

#=============================================================================
# MONITORING & LOGGING
#=============================================================================
# Log levels: debug, info, warn, error, critical
LOG_LEVEL=warn

# Enable/disable specific logging
LOG_SQL=false
LOG_DB=false
LOG_HTTP=false

#=============================================================================
# BACKUP CONFIGURATION
#=============================================================================
# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Backup schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

#=============================================================================
# CLUSTER CONFIGURATION (for multi-instance deployment)
#=============================================================================
# Instance identifier (useful for load balancing)
INSTANCE_ID=prod-01

# Load balancer configuration
LB_STICKY_SESSIONS=true

#=============================================================================
# DEVELOPMENT FLAGS (keep false in production)
#=============================================================================
DEBUG_MODE=false
DEVELOPMENT_MODE=false
AUTO_RELOAD=false 